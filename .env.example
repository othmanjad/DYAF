# Elasticsearch connection settings.
# Copy this file to `.env` and fill in your values — the server loads it
# automatically on startup (existing environment variables take precedence).

# Cluster URL. If unset, an embedded dev/test double is started instead.
ELASTICSEARCH_URL=https://localhost:9200

# --- Authentication (choose ONE method) -------------------------------
# 1) Basic authentication (username + password)
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me

# 2) OR an Elasticsearch API key (base64 "id:api_key" as issued by ES).
#    Takes precedence over username/password when set.
#ELASTICSEARCH_API_KEY=

# --- TLS ---------------------------------------------------------------
# Path to the cluster CA certificate (e.g. http_ca.crt generated by ES 8).
#ELASTICSEARCH_CA_CERT=/path/to/http_ca.crt

# Set to false ONLY for local development with self-signed certificates.
#ELASTICSEARCH_VERIFY_CERTS=true

# --- Server ------------------------------------------------------------
#PORT=8000
