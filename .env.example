# Copy to .env — loaded automatically at startup (env vars take precedence).

# Cluster URL. Unset => embedded dev/test double starts automatically.
ELASTICSEARCH_URL=https://localhost:9200

# Authentication: basic (username+password) OR api key (takes precedence)
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
#ELASTICSEARCH_API_KEY=

# TLS
#ELASTICSEARCH_CA_CERT=/etc/elasticsearch/certs/http_ca.crt
#ELASTICSEARCH_VERIFY_CERTS=true

# Server
#HOST=127.0.0.1        # 0.0.0.0 to expose (protect with a firewall!)
#PORT=8000
#DYAF_DB=dyaf.db
